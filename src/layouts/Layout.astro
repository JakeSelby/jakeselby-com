---
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Analytics from '../components/Analytics.astro';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
  hideFooter?: boolean;
}

const {
  title,
  description = 'Jake Selby — VP Engineering at Arcadia, agentic builder, and civic technologist based in Hyattsville, MD.',
  currentPath = '/',
  hideFooter = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://jakeselby.com').href;
const ogImage = 'https://jakeselby.com/jake.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Google tag (gtag.js) -->
    <Analytics />

    <meta name="description" content={description} />
    <meta name="author" content="Jake Selby" />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Google Search Console verification -->
    <meta name="google-site-verification" content="3BzYlq9bJavBRSYOEeI7r5y1tdSVnOpqoeRHILBxI5M" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Jake Selby" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content="https://jakeselby.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Jake Selby — VP Engineering · Dad · Builder · Believer in tech for good" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://jakeselby.com/og.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-md focus:bg-[var(--color-accent)] focus:text-white focus:font-body focus:text-sm focus:font-medium"
    >
      Skip to content
    </a>
    <SiteNav currentPath={currentPath} />
    <main id="main-content">
      <slot />
    </main>
    {!hideFooter && <SiteFooter />}
  </body>
</html>
