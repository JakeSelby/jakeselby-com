---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SocialLinks from '../components/SocialLinks.astro';

const projects = [
  {
    name: 'Cortex',
    tagline: 'An AI that earns the right to act on your behalf.',
    reason: 'I wanted to build a cognitive substrate for my agents to govern their behavior.',
    brandColor: '#60a5fa',
    statusLabel: 'MVP prod · dogfood',
    statusTone: 'production' as const,
    stack: ['TypeScript', 'Hono', 'pgvector', 'MCP'],
    links: {
      pitch: { href: 'https://cortex.jakeselby.com/pitch/builders', label: 'Explainer' },
    },
  },
  {
    name: 'Consul',
    tagline: 'Your ambient AI executive assistant.',
    reason: "I've always wanted to make Jarvis from Iron Man — an agent that knows everything about me and helps my life.",
    brandColor: '#1E3A8A',
    statusLabel: 'Alpha prod · MVP dev',
    statusTone: 'alpha' as const,
    stack: ['Next.js 15', 'React 19', 'Tailwind'],
    links: {
      pitch: { href: 'https://consul.jakeselby.com/pitch', label: 'Explainer' },
    },
  },
  {
    name: 'Groundwork',
    tagline: 'Modern voter contact, outside the machine.',
    reason: "Progressive campaigns shouldn't have to ask permission for their own data.",
    brandColor: '#2D6A4F',
    statusLabel: 'In production',
    statusTone: 'production' as const,
    stack: ['React', 'NestJS', 'PostGIS'],
    links: {
      app: { href: 'https://groundwork.jakeselby.com/demo', label: 'See demo' },
    },
  },
  {
    name: 'Fable',
    tagline: 'A date-night companion for busy couples.',
    reason: 'I wanted to build a fun app for my wife and I to plan dates with — now expanding it to friends and others.',
    brandColor: '#9333ea',
    statusLabel: 'TestFlight',
    statusTone: 'beta' as const,
    stack: ['Swift', 'React Native', 'Node.js'],
    links: {
      app: { href: 'https://fable.jakeselby.com', label: 'Explainer' },
    },
  },
  {
    name: 'Agent Harness',
    tagline: 'The rules, skills and hooks that make my coding agents legible.',
    reason: 'I wanted a public, installable version of the harness I run every day, so I could compare it with others and cross-pollinate with work.',
    brandColor: '#d97706',
    statusLabel: 'v0.2 · open source',
    statusTone: 'beta' as const,
    stack: ['Claude Code', 'Python', 'Markdown'],
    links: {
      app: { href: 'https://agent-harness.jakeselby.com', label: 'Reference' },
      repo: { href: 'https://github.com/JakeSelby/agent-harness', label: 'GitHub' },
    },
  },
];

const interests = [
  'Chess', 'Guitar & Drums', 'Tennis', 'NBA', 'Ravens',
  'March Madness', 'Hiking', 'Biking', 'Gardening',
  'Cooking', 'Weight Training',
];
---

<Layout
  title="Jake Selby — Dad, Builder, VP Engineering"
  description="Jake Selby — dad, builder, and believer in tech for good. VP Engineering at Arcadia. Political tech, healthcare, and AI for positive impact. Hyattsville, MD."
  currentPath="/"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": "https://jakeselby.com/#jake",
        "name": "Jake Selby",
        "url": "https://jakeselby.com",
        "image": "https://jakeselby.com/jake.png",
        "jobTitle": "VP Engineering",
        "worksFor": {
          "@type": "Organization",
          "name": "Arcadia"
        },
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Hyattsville",
          "addressRegion": "MD",
          "addressCountry": "US"
        },
        "sameAs": [
          "https://github.com/JakeSelby",
          "https://www.linkedin.com/in/jake-selby/",
          "https://www.facebook.com/jake.selby"
        ],
        "knowsAbout": [
          "Software Engineering",
          "Agentic AI",
          "Political Technology",
          "Healthcare Technology",
          "Tech for Social Good"
        ]
      },
      {
        "@type": "WebSite",
        "@id": "https://jakeselby.com/#website",
        "url": "https://jakeselby.com",
        "name": "Jake Selby",
        "description": "Dad, builder, and believer in tech for good.",
        "author": {
          "@id": "https://jakeselby.com/#jake"
        }
      }
    ]
  })} />

  <div class="max-w-5xl mx-auto px-6">
    <div class="lg:grid lg:grid-cols-[280px_1fr] lg:gap-12">

      <!-- ─── Identity Rail ─────────────────────────────────── -->
      <aside
        aria-label="Jake Selby profile"
        class="pt-12 pb-8 border-b border-[var(--color-border)]
               lg:pt-20 lg:pb-24 lg:border-b-0 lg:sticky lg:top-20 lg:self-start"
      >
        <!-- Photo + identity block:
             mobile = flex row (photo left, text right)
             desktop = flex col (photo above, text below) -->
        <div class="flex items-center gap-5 lg:flex-col lg:items-start lg:gap-0">
          <img
            src="/jake.png"
            alt="Jake Selby smiling outdoors with mountains in the background"
            width="112"
            height="112"
            class="rounded-full shrink-0 object-cover object-center w-20 h-20 lg:w-28 lg:h-28 lg:mb-5 ring-2 ring-[var(--color-border)]"
          />
          <div>
            <h1 class="font-display font-bold text-3xl lg:text-[2rem] tracking-tight leading-[1.1] text-fg">
              Jake Selby
            </h1>
            <p class="font-body font-medium text-sm text-fg-2 mt-1.5">
              VP Engineering · Arcadia
            </p>
            <p class="font-body text-sm text-fg-dim mt-0.5">
              Dad&nbsp;·&nbsp;Builder&nbsp;·&nbsp;Believer in tech for good
            </p>
            <p class="font-body text-xs text-fg-dim mt-0.5">
              Hyattsville, MD
            </p>
          </div>
        </div>

        <!-- Social / contact links -->
        <div class="mt-5 lg:mt-7">
          <SocialLinks />
        </div>

        <!-- Intro paragraph — mobile only (desktop has it top of right col) -->
        <p class="lg:hidden font-body text-base text-fg-2 leading-relaxed mt-5 max-w-[55ch]">
          I run product and engineering teams during the day, build things I care about at
          night, and try to leave whatever I touch a little better than I found it.
        </p>
      </aside>

      <!-- ─── Main content ───────────────────────────────────── -->
      <div class="pb-16">

        <!-- Intro paragraph — desktop only -->
        <section class="hidden lg:block pt-20 pb-10">
          <p class="font-body text-lg text-fg-2 leading-relaxed max-w-[60ch]">
            I run product and engineering teams during the day, build things I care about at
            night, and try to leave whatever I touch a little better than I found it.
          </p>
        </section>

        <!-- ─── What I'm About ──────────────────────────────── -->
        <section class="py-8 border-t border-[var(--color-border-subtle)]">
          <h2 class="font-display font-semibold text-xl text-fg mb-3">What I'm About</h2>
          <p class="font-body text-base text-fg-2 leading-relaxed max-w-[65ch]">
            I believe access to technology, good information, and democratic
            institutions should belong to everyone, not just the people who can
            afford them. The work I find most meaningful is at that intersection:
            healthcare systems that actually reach people, organizing tools that
            challengers can afford, AI that earns trust rather than demanding it.
          </p>
        </section>

        <!-- ─── Story ───────────────────────────────────────── -->
        <section class="py-8 border-t border-[var(--color-border-subtle)]">
          <h2 class="font-display font-semibold text-xl text-fg mb-3">How I Got Here</h2>
          <p class="font-body text-base text-fg-2 leading-relaxed max-w-[65ch]">
            I knocked doors for Obama in 2012, built data pipelines for the DNC in
            2016, then spent seven years as an engineer and leader in healthcare.
            Joined CareJourney as employee&nbsp;#7 and led engineering through its
            acquisition by Arcadia, where I run a 48-person org today. Through all
            of it, the thread is the same: I like building things that matter.
          </p>
        </section>

        <!-- ─── Building ──────────────────────────────────────  -->
        <section class="py-8 border-t border-[var(--color-border)]">
          <div class="mb-6">
            <h2 class="font-display font-semibold text-xl text-fg">Recent personal projects</h2>
            <p class="font-body text-sm text-fg-2 mt-1">
              Four production systems, each one solving a problem I care about personally.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            {projects.map((project) => (
              <ProjectCard
                name={project.name}
                tagline={project.tagline}
                reason={project.reason}
                brandColor={project.brandColor}
                statusLabel={project.statusLabel}
                statusTone={project.statusTone}
                stack={project.stack}
                links={project.links}
                variant="compact"
                headingLevel="h3"
              />
            ))}
          </div>

          <div class="flex justify-end mt-5">
            <a
              href="/projects"
              class="inline-flex items-center gap-1.5 font-body font-medium text-sm text-fg-2 hover:text-fg transition-colors duration-[120ms]"
            >
              All projects
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </a>
          </div>
        </section>

        <!-- ─── Outside the Terminal ─────────────────────────── -->
        <section class="py-8 border-t border-[var(--color-border-subtle)]">
          <h2 class="font-display font-semibold text-xl text-fg mb-5">Outside the Terminal</h2>

          <div class="space-y-3 font-body text-base text-fg-2 leading-relaxed max-w-[65ch]">
            <p>Husband. Dad of two. Hyattsville, MD.</p>
            <p>
              Grew up playing basketball, baseball, wrestling, rugby, soccer,
              tennis, and track. More of a watcher now: Ravens season ticket holder,
              and at March Madness every year.
            </p>
            <p>
              Plays guitar and drums, and likes a little of everything when it
              comes to music.
            </p>
            <p>
              Reads a lot about politics, geopolitics, and philosophy. Politics
              because outcomes matter. Geopolitics because world power structures
              and events are genuinely fascinating. Philosophy for the critical
              thinking and the questions about meaning.
            </p>
            <p>
              Outside of that: biking, hiking, cooking, gardening, the gym, and
              time with friends and family.
            </p>
          </div>

          <ul
            aria-label="Interests"
            class="flex flex-wrap gap-2 mt-6 list-none p-0"
          >
            {interests.map((interest) => (
              <li>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-[4px] font-mono text-xs text-fg-2 bg-surface border border-[var(--color-border)]">
                  {interest}
                </span>
              </li>
            ))}
          </ul>
        </section>

      </div>
    </div>
  </div>
</Layout>
